# 복사해서 쓴다: cp .env.example .env   (.env는 git에 올리지 않는다)

# LLM 백엔드: ollama(기본, 로컬·무료) | openai(과금, Ollama가 느린 맥북용)
LLM_BACKEND=ollama
# FAST_MODEL=qwen3:8b
# QUALITY_MODEL=qwen3:8b

# LLM_BACKEND=openai일 때만 필요. 본인 키를 .env에만 넣는다
OPENAI_API_KEY=
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o-mini

# LangSmith 추적 (선택)
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=meeting-decision-ledger
LANGSMITH_PROJECT=meeting-decision-ledger
